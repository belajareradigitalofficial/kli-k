# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env yang berisi nilai asli.

NODE_ENV=development
PORT=3000

# Origin frontend yang diizinkan (boleh lebih dari satu, pisahkan koma).
CORS_ORIGIN=http://localhost:5173

# URL publik backend, dipakai untuk membentuk shortUrl di response.
# Harus menunjuk ke backend (bukan Vite), karena redirect /:slug
# ditangani Express.
BASE_URL=http://localhost:3000

# Koneksi MySQL. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://user:password@127.0.0.1:3306/klik

# Opsional: masa berlaku sesi login dalam hari (default 7).
# SESSION_TTL_DAYS=7

# Opsional. Isi hanya kalau aplikasi di belakang reverse proxy tepercaya
# (nginx, Cloudflare). Contoh: 1
# TRUST_PROXY=1

# Opsional. Preview Open Graph untuk crawler media sosial (WhatsApp,
# Telegram, …): batas waktu mengambil halaman tujuan, dan umur cache-nya.
# OG_FETCH_TIMEOUT_MS=5000
# OG_CACHE_TTL_HOURS=168
